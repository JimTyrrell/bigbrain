{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bigbrain",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bigbrain-db",
      "database_id": "67408d50-30a2-463a-bc1b-93f0abd32543",
      "migrations_dir": "migrations"
    }
  ],
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "bigbrain-vectors", "remote": true }],
  "kv_namespaces": [{ "binding": "KV", "id": "90a350cf2180411c9bb689002d85b7cb" }],
  "observability": { "enabled": true },
  "vars": {
    "DEFAULT_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "WHISPER_MODEL": "@cf/openai/whisper-large-v3-turbo",
    "KV_NAMESPACE_ID": "90a350cf2180411c9bb689002d85b7cb",
    "PUBLIC_URL": "https://bigbrain.designaticlabs.com"
  }
}
