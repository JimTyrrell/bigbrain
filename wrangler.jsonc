{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bigbrain",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "7f7032ce4d80f42047c82217657811b8",
  "routes": [{ "pattern": "bigbrain.designaticlabs.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bigbrain-db",
      "database_id": "6b09db0d-5e64-426e-82b3-e594b2f53b85",
      "migrations_dir": "migrations"
    }
  ],
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "bigbrain-vectors" }],
  "kv_namespaces": [{ "binding": "KV", "id": "6b4c69be0e634170994513edd4c93aaa" }],
  "observability": { "enabled": true },
  "vars": {
    "DEFAULT_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "WHISPER_MODEL": "@cf/openai/whisper-large-v3-turbo"
  }
}
